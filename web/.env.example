# ---------------------------------------------------------------------------
# Arc network (mainnet by default). For testnet use chain id 5042002,
# https://rpc.testnet.arc.network and https://testnet.arcscan.app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io
# Native USDC (6-decimal ERC-20 interface) is the same address on Arc mainnet and testnet.
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Deployed contracts (fill in after running the mainnet deploy scripts).
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=

# Privy auth (https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# Server-side keys. These MUST be two DIFFERENT keys on mainnet:
#  - EXECUTOR_PRIVATE_KEY only submits executeSpendFor; it can never change policy
#    or withdraw, so its blast radius is bounded by each vault's on-chain leash.
#  - VAULT_OWNER_PRIVATE_KEY is used ONLY by the deploy scripts (never by the running
#    app) to deploy the factory and reference vault. Keep it offline after deployment.
# Never commit real keys. Use fresh mainnet keys - do not reuse testnet keys.
# ---------------------------------------------------------------------------
EXECUTOR_PRIVATE_KEY=
VAULT_OWNER_PRIVATE_KEY=

# Testnet executor key - ONLY needed if you enable the in-app testnet toggle so users can try the
# product on Arc testnet first. Agents created while the app is set to testnet are bound to testnet,
# and their spends are signed with this key. Leave blank to keep the app mainnet-only.
EXECUTOR_PRIVATE_KEY_TESTNET=

# ---------------------------------------------------------------------------
# Turso/libSQL - REQUIRED in production. The policy fence reads from this store,
# and a local SQLite file does not persist on serverless hosts (Vercel), which
# would silently wipe policy state on every deploy. Provision a Turso database.
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
